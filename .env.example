# Required Telegram settings.
TG_BOT_TOKEN=123456:replace_with_your_bot_token
TG_ALLOWED_CHAT_ID=464100862

# Required CMS settings.
CMS_BASE_URL=http://192.168.1.10:9527
CMS_USERNAME=your_cms_username
CMS_PASSWORD=replace_with_your_cms_password

# Runtime storage.
DB_PATH=/data/submissions.db
TASK_DB_PATH=/data/tasks.db
# SQLite 在线备份：默认每天 03:30（Asia/Shanghai），快照保存在 /data/backups，保留 14 天。
BACKUP_ENABLED=true
BACKUP_TIME=03:30
BACKUP_TIMEZONE=Asia/Shanghai
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=14
TG_POLL_TIMEOUT=30
HTTP_TIMEOUT=60
STATUS_POLL_SECONDS=300
STATUS_POLL_INTERVAL=20
LOG_LEVEL=INFO
# 相同级别+来源+消息 1 秒内只保留一条（默认关闭；开启会丢弃重复日志细节）
LOG_RATE_LIMIT_ENABLED=false

# Workflow mode:
# - direct: submit original share link to CMS and let CMS handle its normal flow.
# - self_share_sync: transfer, wait for CMS organize, create your own permanent 115 share, run CMS share-sync, move share STRM, then optionally delete the transferred 115 source after confirmation.
WORKFLOW_MODE=self_share_sync
STRM_DEFAULT_MODE=shared
FRONTEND_DIST_PATH=/app/frontend/dist

# 115 self-share workflow.
P115_COOKIE_PATH=/config/115-cookies.txt
# 115 API 最小请求间隔；账号被风控后建议调大到 3-5。
P115_MIN_REQUEST_INTERVAL_SECONDS=2
# 115 风控/频率限制触发后的全局冷却秒数；冷却期间暂停新的 115/CMS 全局阶段。
P115_RISK_COOLDOWN_SECONDS=900
# 初始待整理目录 CID；也可在 Web 设置中修改，Web 值会持久化并优先于此值。
# 修改只影响之后的新接收/云下载尝试，运行中的任务继续使用已保存的 CID。
SELF_SHARE_RECEIVE_CID=
SELF_SHARE_STRM_ROOT=/mnt/user/Unraid/strm/share
SELF_SHARE_CMS_LOCAL_PATH=/media/share
SELF_SHARE_CMS_CID=0
# Historical env name. With TASK_ENGINE_ENABLED=true, source cleanup is delayed
# until the self-share passes the asynchronous review checkpoints below.
# The legacy SubmissionStore path does not automatically delete sources;
# enable TaskRunner for reviewed cleanup.
SELF_SHARE_CLEANUP_AFTER_EMBY=true
# Optional: comma-separated 115 parent CIDs to clean matching receive-stage residues from.
SELF_SHARE_SOURCE_CLEANUP_PARENT_IDS=
SELF_SHARE_AUTO_ORGANIZE_RETRY_SECONDS=15
# 云下载状态查询至少间隔 30 秒；超时只结束任务，不会删除 115 文件。
# 磁力/ED2K 始终使用 shared STRM；云任务查找最多检查 3 页、每页 30 项。
SELF_SHARE_CLOUD_POLL_SECONDS=30
SELF_SHARE_CLOUD_TIMEOUT_SECONDS=86400
# Fallback receive code for newly created own shares. Web UI and CMS share-sync settings take precedence.
SELF_SHARE_OWN_SHARE_PASSWORD=1212
# Disabled by default. When enabled, probe at most this many completed self-shares per interval.
# Only confirmed permanently-invalid shares are cleaned; risk control and unknown errors retain STRM files.
SELF_SHARE_INVALID_CLEANUP_ENABLED=false
SELF_SHARE_INVALID_CHECK_INTERVAL_SECONDS=21600
SELF_SHARE_INVALID_CHECK_LIMIT=3
SELF_SHARE_REVIEW_GRACE_SECONDS=86400
SELF_SHARE_REVIEW_CHECKPOINTS_SECONDS=600,3600,21600,86400
SELF_SHARE_REVIEW_LIST_CACHE_SECONDS=300
# Read-only CMS SQLite index. The default matches the bundled Docker Compose mount.
CMS_STATE_DB_PATH=/cms/cms-online.db

# Optional: map your CMS organized 115 parent folder CIDs to categories.
# Format: parent_cid=category,parent_cid=category
# Leave blank to disable parent-CID category inference, or set this for your own CMS folder IDs.
CMS_PARENT_CID_CATEGORY_MAP=

# STRM move settings.
STRM_SOURCE_ROOTS=/mnt/user/Unraid/strm/share,/mnt/user/Unraid/strm/转存
MOVE_CONFLICT_POLICY=merge
STRM_STABLE_SECONDS=30
# Format: category=absolute_path,category=absolute_path
STRM_LIBRARY_MAP=华语电影=/mnt/user/Unraid/strm/转存/Movie/电影/华语电影,欧美电影=/mnt/user/Unraid/strm/转存/Movie/电影/欧美电影,亚洲电影=/mnt/user/Unraid/strm/转存/Movie/电影/亚洲电影,动漫电影=/mnt/user/Unraid/strm/转存/Movie/电影/动漫电影,国产电视=/mnt/user/Unraid/strm/转存/TVCN,外国电视=/mnt/user/Unraid/strm/转存/TV,番剧=/mnt/user/Unraid/strm/转存/Dongman

# Emby confirmation.
EMBY_BASE_URL=http://192.168.1.10:8096
EMBY_API_KEY=replace_with_your_emby_api_key
EMBY_USER_ID=

# Optional OpenAI-compatible fallback classification.
OPENAI_CLASSIFY_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace_only_if_enabled
OPENAI_MODEL=gpt-4.1-mini
OPENAI_HIGH_CONFIDENCE=0.75
OPENAI_SUGGEST_CONFIDENCE=0.45

# Optional TMDB official API fallback classification.
# Prefer TMDB_BEARER_TOKEN when you have a v4 Read Access Token; TMDB_API_KEY also works.
TMDB_API_KEY=
TMDB_BEARER_TOKEN=

# Optional HDHive search/unlock through the CMS-bound OAuth account.
# First authorize the account in CMS: 转存下载 -> 影巢账号.
HDHIVE_ENABLED=false
HDHIVE_PROXY_BASE_URL=https://authx.771885.xyz
HDHIVE_TOKEN_CONFIG_PATH=/config/cms-config/hdhive-openapi.json
HDHIVE_SEARCH_SESSION_TTL_SECONDS=900
HDHIVE_AUTO_UNLOCK_MAX_POINTS=20
HDHIVE_SUBSCRIPTION_AUTO_ENABLED=true
HDHIVE_SUBSCRIPTION_TIME=01:30
HDHIVE_SUBSCRIPTION_TIMEZONE=Asia/Shanghai

# v0.2 authoritative task engine and Web admin.
# Set TASK_ENGINE_ENABLED=false to roll back to the legacy SubmissionStore + polling path.
TASK_ENGINE_ENABLED=true
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8787
WEB_TOKEN=
TASK_WORKER_INTERVAL_SECONDS=5
# Web 和 Telegram 共用此重试上限；非法或非正值回退到 3。
TASK_MAX_RETRIES=3

# Daily quality auto-repair. Enable only after the TaskStore workflow has passed a manual test.
QUALITY_AUTO_ENABLED=false
QUALITY_AUTO_TIME=02:50
QUALITY_AUTO_TIMEZONE=Asia/Shanghai
QUALITY_AUTO_MAX_TASKS=50
QUALITY_AUTO_115_CHECK_LIMIT=3
# 历史遗留终态问题自动归档前的等待秒数（默认 604800 = 7 天）
QUALITY_ARCHIVE_AFTER_SECONDS=604800
# 不可修复终态任务自动删除前的保留天数（默认 30，0 表示关闭自动删除）
QUALITY_UNFIXABLE_RETENTION_DAYS=30

# Background repair for stuck records.
STATUS_REPAIR_ENABLED=true
STATUS_REPAIR_INTERVAL_SECONDS=300
STATUS_REPAIR_LIMIT=50
